import os
import threading
from flask import Flask
import telebot

app = Flask(__name__)

TOKEN = os.environ.get("TELEGRAM_TOKEN")
bot = telebot.TeleBot(TOKEN)

@bot.message_handler(commands=['start'])
def send_welcome(message):
    bot.reply_to(message, "හායි බොස්! මම sani_server_bot. මම හදලා තියෙන්නේ ඔයා වෙනුවෙන්ම! 😎")

@bot.message_handler(commands=['help'])
def send_help(message):
    bot.reply_to(message, "ඕනෑම දෙයක් අහන්න, මම උත්තර දෙන්නම්!\n\nCommands:\n/start - බෝට් එක පටන් ගන්න\n/help - මේක")

@bot.message_handler(func=lambda message: True)
def echo_all(message):
    bot.reply_to(message, f"ඔයා කිව්වේ: {message.text}")

@app.route('/')
def home():
    return "Bot is running!"

@app.route('/health')
def health():
    return "OK"

def run_bot():
    print("🟢 බෝට් එක වැඩ කරනවා...")
    bot.infinity_polling()

if __name__ == "__main__":
    bot_thread = threading.Thread(target=run_bot)
    bot_thread.daemon = True
    bot_thread.start()
    
    port = int(os.environ.get("PORT", 5000))
    app.run(host="0.0.0.0", port=port)
